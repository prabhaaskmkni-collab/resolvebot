# ResolveBot — Environment Configuration Template
# Copy this file to .env and fill in your API key

# Paths to data files (default: ./data/)
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db

# The date the app treats as "today" (never use real system clock for business logic)
APP_TODAY=2026-07-01

# LLM provider: openai | google | anthropic
LLM_PROVIDER=google

# API Keys — fill in ONE depending on your provider
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307
